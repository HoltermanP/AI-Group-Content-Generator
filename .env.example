# ════════════════════════════════════════════════════════════════════════════
# AI-Group LinkedIn Content Generator — environment variables
#
# LIVEGANG: vul de waarden hieronder in en de applicatie werkt volledig.
# Zonder OPENAI_API_KEY draait de app in stub-modus (voorbeeldposts en
# placeholder-afbeeldingen) zodat alles lokaal testbaar blijft.
# ════════════════════════════════════════════════════════════════════════════

# ─── Database (VERPLICHT) ────────────────────────────────────────────────────
# PostgreSQL connection string. Productie: bijv. Neon, Supabase of Vercel Postgres.
# Lokaal via Docker:
#   docker run --name aigroup-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=aigroup -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aigroup?schema=public"

# ─── NextAuth (VERPLICHT) ────────────────────────────────────────────────────
# Genereer met: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Lokaal: http://localhost:3000 — productie: https://jouw-domein.nl
NEXTAUTH_URL="http://localhost:3000"

# ─── OpenAI (VERPLICHT voor echte generatie) ─────────────────────────────────
# Zodra deze key is ingevuld worden teksten én afbeeldingen echt gegenereerd.
OPENAI_API_KEY=""
OPENAI_TEXT_MODEL="gpt-4o"
OPENAI_IMAGE_MODEL="gpt-image-1"

# ─── Image provider ──────────────────────────────────────────────────────────
# "auto" (aanbevolen): OpenAI zodra OPENAI_API_KEY is ingevuld, anders placeholders.
# "openai" of "stub" om het expliciet vast te zetten.
IMAGE_PROVIDER="auto"

# ─── Afbeeldingsopslag (VERPLICHT op Vercel) ─────────────────────────────────
# Vercel Blob: maak een Blob store aan in het Vercel-dashboard (Storage → Blob);
# de token wordt dan automatisch als env var aan het project gekoppeld.
# Zonder token worden afbeeldingen lokaal opgeslagen (alleen geschikt voor lokaal).
BLOB_READ_WRITE_TOKEN=""

# ─── LinkedIn (OPTIONEEL — voor automatische publicatie) ─────────────────────
# Maak een app aan op https://developer.linkedin.com en activeer de producten
# "Sign In with LinkedIn using OpenID Connect", "Share on LinkedIn" én
# "Community Management API" (nodig om namens de bedrijfspagina te posten;
# koppel de app in de Developer Portal aan de AI-Group bedrijfspagina).
# Redirect URL: <NEXTAUTH_URL>/api/integrations/linkedin/callback
# Zonder deze keys werkt de handmatige flow + Chrome-extensie volledig.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# ─── LinkedIn-bedrijfspagina ─────────────────────────────────────────────────
# Alle publicaties (API, Chrome-extensie én browserflow) gaan namens deze
# bedrijfspagina. Het id staat in de admin-URL:
#   https://www.linkedin.com/company/110094547/admin/dashboard/
# Standaard is dit de AI-Group pagina; zet op "personal" om toch op het
# persoonlijke profiel te publiceren.
LINKEDIN_ORGANIZATION_ID="110094547"
# Versie van de LinkedIn Marketing API (YYYYMM, max. ~1 jaar oud). Optioneel.
# LINKEDIN_API_VERSION="202606"
# Scopes overschrijven (normaal niet nodig). Optioneel.
# LINKEDIN_OAUTH_SCOPES="openid profile w_member_social w_organization_social r_organization_admin"

# ─── Cron beveiliging (VERPLICHT in productie) ───────────────────────────────
# Genereer met: openssl rand -hex 24
# Vercel Cron stuurt deze automatisch mee als "Authorization: Bearer <secret>".
CRON_SECRET=""

# ─── Beeldkwaliteit ──────────────────────────────────────────────────────────
# gpt-image-1 kwaliteit: "high" (standaard, meest fotorealistisch), "medium" of "low" (goedkoper).
OPENAI_IMAGE_QUALITY="high"
