{
  "manifest_version": 3,
  "name": "AI-Group Publicatie-assistent",
  "version": "1.2.0",
  "description": "Plaatst goedgekeurde AI-Group posts klaar in LinkedIn namens de bedrijfspagina: tekst en afbeelding in de composer. Jij klikt zelf op Posten.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI-Group Publicatie-assistent"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "downloads", "tabs"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.linkedin.com/*",
    "http://localhost/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://*/*"],
      "exclude_matches": ["https://www.linkedin.com/*", "https://*.linkedin.com/*"],
      "js": ["app-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/*", "https://*.linkedin.com/*"],
      "js": ["linkedin-publisher.js"],
      "run_at": "document_idle"
    }
  ]
}
